<?php
//Solo permitir acceso con sesión y por POST
if (!isset($_SESSION['user']) || !isset($_POST['task_id'])) {
    header("Location: index.php");
    exit;
}

$taskId = $_POST['task_id'];
$task = Task::getTaskById($taskId);

//Comprobar que la tarea existe y que el usuario es el dueño o tiene acceso compartido
$userId = $_SESSION['user']->getId();
$isOwner = ($task && $task->getUser_id() == $userId);
$isSharedWithUser = false;
if ($task) {
    $sharedTasks = Task::getShareTasks($userId);
    foreach ($sharedTasks as $st) {
        if ($st && $st->getId() == $taskId) {
            $isSharedWithUser = true;
            break;
        }
    }
}

if (!$task || (!$isOwner && !$isSharedWithUser)) {
    header("Location: index.php");
    exit;
}

//Crear nueva etiqueta y asignarla automáticamente a la tarea actual
if (isset($_POST['createTag']) && isset($_POST['name'])) {
    if ($_POST['name'] != '') {
        $tag = Tag::createTag($_POST['name']);
        if ($tag) {
            Tag::addTagToTask($taskId, $tag->getId());
        }
    }
}

//Procesar añadir/quitar etiquetas
if (isset($_POST['modTag']) && isset($_POST['tag_id'])) {
    if ($_POST['modTag'] == 'add') {
        Tag::addTagToTask($taskId, $_POST['tag_id']);
    }
    if ($_POST['modTag'] == 'remove') {
        Tag::removeTagFromTask($taskId, $_POST['tag_id']);
    }
}

//Obtener etiquetas asignadas y disponibles
$assignedTags = Tag::getTagsByTaskId($taskId);
$availableTags = Tag::getAvailableTagsForTask($taskId);
?>
