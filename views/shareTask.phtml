<?php
require_once('models/Task.php');
require_once('models/User.php');
require_once('db.php');

// Solo permitir acceso con sesión y por POST
if (!isset($_SESSION['user']) || !isset($_POST['task_id'])) {
    header("Location: index.php");
    exit;
}

$taskId = $_POST['task_id'];
$task = Task::getTaskById($taskId);

// Si la tarea no existe o el dueño no es el usuario actual, redirigir a inicio
if (!$task || $task->getUser_id() != $_SESSION['user']->getId()) {
    header("Location: index.php");
    exit;
}

// Procesar añadir/quitar accesos exclusivamente por POST
if (isset($_POST['modAcces']) && isset($_POST['user_id'])) {
    if ($_POST['modAcces'] == 'add') {
        Task::shareTask($_POST['user_id'], $taskId);
    }
    if ($_POST['modAcces'] == 'remove') {
        Task::unshareTask($_POST['user_id'], $taskId);
    }
}

// Obtener listas de usuarios actualizadas tras procesar cualquier acción
$usersWithAccess = Task::getUsersWithAccess($taskId);
$usersWithoutAccess = Task::getUsersWithOutAccess($taskId, $_SESSION['user']->getId());
?>

